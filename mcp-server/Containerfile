# MCP Server Containerfile

FROM node:22-bookworm-slim

WORKDIR /usr/src/app

ENV MCP_HOST_BIND=0.0.0.0
ENV MCP_PORT=4000

# Install dependencies as root before dropping privileges
COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

RUN chown -R node:node /usr/src/app

# Drop to non-root user provided by the node image
USER node

EXPOSE 4000

CMD ["node", "server.js"]
