APP_NAME=Linavelt
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Production: switch to MariaDB/PostgreSQL
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=linavelt
# DB_USERNAME=linavelt
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Production: SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIES=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Production: QUEUE_CONNECTION=redis

CACHE_STORE=database
# Production: CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Production: MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MCP Server
MCP_API_KEY=
MCP_PORT=4000
# AUTOMATION_POLICY_PROFILE=default

# Flux Pro (required for composer install)
# COMPOSER_AUTH={"http-basic":{"composer.fluxui.dev":{"username":"","password":""}}}

# AWS (uncomment to use)
# AWS_ACCESS_KEY_ID=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
