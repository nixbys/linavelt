{
    "private": true,
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "check:preflight": "sh ./scripts/build/preflight-check.sh",
        "release:smoke": "node ./scripts/release/electron-release-smoke.mjs",
        "security:audit": "npm audit --omit=dev && cd mcp-server && npm audit --omit=dev",
        "electron:start": "electron .",
        "electron:pack": "electron-builder --dir",
        "electron:build": "npm run build && electron-builder"
    },
    "build": {
        "appId": "com.linavelt.app",
        "productName": "Linavelt",
        "directories": {
            "output": "release"
        },
        "files": [
            "electron/**/*",
            "public/**/*",
            "!node_modules/**/*"
        ],
        "extraResources": [
            {
                "from": ".",
                "to": "app",
                "filter": [
                    "app/**/*",
                    "bootstrap/**/*",
                    "config/**/*",
                    "database/**/*",
                    "resources/**/*",
                    "routes/**/*",
                    "storage/**/*",
                    "artisan",
                    "composer.json",
                    "composer.lock",
                    "public/**/*",
                    "vendor/**/*"
                ]
            }
        ],
        "linux": {
            "target": "AppImage",
            "category": "Utility"
        },
        "mac": {
            "target": "dmg"
        },
        "win": {
            "target": "nsis"
        }
    },
    "dependencies": {
        "@tailwindcss/aspect-ratio": "^0.4.2",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.2",
        "autoprefixer": "^10.5.3",
        "axios": "^1.18.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.0",
        "tailwindcss": "^4.3.2",
        "vite": "^8.1.2",
        "weakmap-polyfill": "^2.0.4"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.62.2",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.2",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "overrides": {
        "lodash": "4.18.1",
        "esbuild": "^0.28.1"
    },
    "devDependencies": {
        "@ljharb/tsconfig": "^0.3.2",
        "electron": "^43.0.0",
        "electron-builder": "^26.15.3"
    },
    "engines": {
        "node": ">=22"
    }
}
