[Unit]
Description=Linavelt MCP server container for production
After=linavelt-pod.service
Requires=linavelt-pod.service

[Container]
ContainerName=linavelt-mcp
Pod=linavelt.pod
Image=ghcr.io/__GHCR_OWNER__/linavelt-mcp:__IMAGE_TAG__
Environment=MCP_HOST_BIND=0.0.0.0
Environment=MCP_PORT=4000
Environment=MCP_API_KEY=__MCP_API_KEY__

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
