[Unit]
Description=Linavelt Laravel application container
After=linavelt-db.service
Requires=linavelt-pod.service
Wants=linavelt-db.service

[Container]
ContainerName=linavelt-app
Pod=linavelt.pod
Image=localhost/linavelt-app:latest
Environment=APP_ENV=production
Environment=APP_DEBUG=false
Environment=APP_URL=http://127.0.0.1:8000
Environment=APP_KEY=base64:replace-with-secure-key
Environment=DB_CONNECTION=mysql
Environment=DB_HOST=127.0.0.1
Environment=DB_PORT=3306
Environment=DB_DATABASE=laravel
Environment=DB_USERNAME=laravel
Environment=DB_PASSWORD=password
Environment=QUEUE_CONNECTION=database

[Service]
Restart=always

[Install]
WantedBy=default.target
